# Schema version 1 — see docs/design/repoman.md
version: 1

settings:
  default_action: preview
  log_level: info
  parallelism: 4
  changes_only: false

paths:
  workspace_root: "~/repositories"
  cache_root: "~/.cache/repoman"
  state_root: "~/.local/state/repoman"

layout: "{remote}/{namespace}/{repo}"

remotes:
  gitlab:
    kind: gitlab
    base_url: "https://gitlab.example.com"
    token_env: "REPOMAN_GITLAB_TOKEN"
    clone_protocol: "ssh"
  github:
    kind: github
    base_url: "https://api.github.com"
    token_env: "REPOMAN_GITHUB_TOKEN"
    clone_protocol: "ssh"

namespaces: []

repos: []

mirrors: []
