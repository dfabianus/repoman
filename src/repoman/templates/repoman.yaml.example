# Schema version 1 — see docs/getting-started.md and docs/design/repoman.md
version: 1

settings:
  default_action: preview
  log_level: info
  parallelism: 4
  changes_only: false

paths:
  # ~ expands to your home directory on Linux, macOS, and Windows.
  workspace_root: "~/repositories"
  cache_root: "~/.cache/repoman"
  state_root: "~/.local/state/repoman"

layout: "{remote}/{namespace}/{repo}"

remotes:
  gitlab:
    kind: gitlab
    base_url: "https://gitlab.example.com"
    token_env: "REPOMAN_GITLAB_TOKEN"
    clone_protocol: "ssh"
  github:
    kind: github
    base_url: "https://api.github.com"
    token_env: "REPOMAN_GITHUB_TOKEN"
    # Or use credentials.toml beside repoman.yaml:
    # token_credentials: "github"
    clone_protocol: "ssh"

# Track all repos in a namespace (uncomment and edit):
# namespaces:
#   - remote: github
#     name: "<your-github-username-or-org>"
#     visibility: [public, private]
#     include: ["**/*"]

namespaces: []

repos: []

mirrors: []
